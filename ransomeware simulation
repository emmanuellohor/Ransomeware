@dataclass
class C2Message:
    """C2 message structure."""
    msg_type: str  # key, status, command, alert
    payload: Dict
    timestamp: str
    machine_id: str

class C2Client:
    """Simulated command & control client."""
    
    def __init__(self, config: Config, machine_id: str):
        self.config = config
        self.machine_id = machine_id
        self.enabled = config.c2_enabled
        self.message_queue: List[C2Message] = []
        self.command_handlers: Dict[str, Callable] = {}
        self._stop = threading.Event()
        self._lock = threading.Lock()
    
    def register_handler(self, command: str, handler: Callable):
        """Register command handler."""
        self.command_handlers[command] = handler
    
    def queue_message(self, msg_type: str, payload: Dict):
        """Queue message for transmission."""
        msg = C2Message(
            msg_type=msg_type,
            payload=payload,
            timestamp=datetime.now().isoformat(),
            machine_id=self.machine_id
        )
        with self._lock:
            self.message_queue.append(msg)
        
        if not self.enabled:
            self._save_offline()
    
    def _save_offline(self):
        """Save queued messages to file when C2 disabled."""
        try:
            data = [asdict(m) for m in self.message_queue]
            with open(self.config.c2_buffer_file, 'w') as f:
                json.dump(data, f, indent=2)
        except Exception as e:
            logger.error(f"Failed to save offline C2 queue: {e}")
    
    def get_system_info(self) -> Dict:
        """Collect system information."""
        try:
            return {
                'hostname': socket.gethostname(),
                'ip': socket.gethostbyname(socket.gethostname()),
                'os': platform.system(),
                'os_version': platform.version(),
                'architecture': platform.machine(),
                'processor': platform.processor(),
                'username': os.getlogin(),
                'python_version': platform.python_version()
            }
        except Exception as e:
            logger.error(f"Failed to collect system info: {e}")
            return {'error': str(e)}
    
    def start(self):
        """Start C2 threads if enabled."""
        if not self.enabled:
            logger.info("C2 disabled - operating in offline mode")
            return
        
        # Simulated C2 loop
        def c2_loop():
            while not self._stop.is_set():
                try:
                    # Process outgoing messages
                    with self._lock:
                        if self.message_queue:
                            logger.debug(f"Would send {len(self.message_queue)} messages to C2")
                            self.message_queue.clear()
                    
                    # Check for commands (simulated)
                    time.sleep(self.config.c2_check_interval)
                    
                except Exception as e:
                    logger.error(f"C2 loop error: {e}")
        
        threading.Thread(target=c2_loop, daemon=True, name="C2-Thread").start()
    
    def stop(self):
        """Stop C2 operations."""
        self._stop.set()
        if self.message_queue:
            self._save_offline()

