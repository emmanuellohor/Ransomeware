            text="UNLOCK",
            command=self._check_code,
            bg='#ff0000',
            fg='white',
            font=('Consolas', 14, 'bold'),
            width=15
        ).pack(pady=20)
        
        # Hint
        tk.Label(
            self.root,
            text=f"Hint: Check the log file or C2 messages for code",
            bg='#000000',
            fg='#666666',
            font=('Consolas', 10)
        ).pack(side='bottom', pady=20)
    
    def _check_code(self):
        entered = self.code_entry.get().strip()
        
        if entered == self.bypass_code:
            self.on_unlock()
            self.root.destroy()
        else:
            self.attempts += 1
            remaining = self.max_attempts - self.attempts
            
            if remaining <= 0:
                self.status_label.config(text="Max attempts exceeded. System remains locked.")
                self.code_entry.config(state='disabled')
            else:
                self.status_label.config(text=f"Invalid code. {remaining} attempts remaining.")
                self.code_entry.delete(0, 'end')
    
    def run(self):
        self.root.mainloop()

