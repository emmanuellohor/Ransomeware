class CryptoEngine:
    """Handles encryption/decryption operations."""
    
    def __init__(self):
        self.key: Optional[bytes] = None
        self.cipher: Optional[Fernet] = None
        self._lock = threading.Lock()
    
    def generate_key(self) -> bytes:
        """Generate new Fernet key."""
        self.key = Fernet.generate_key()
        self.cipher = Fernet(self.key)
        logger.info("New encryption key generated")
        return self.key
    
    def load_key(self, key_path: str) -> bool:
        """Load existing key from file."""
        try:
            with open(key_path, 'rb') as f:
                self.key = f.read()
            self.cipher = Fernet(self.key)
            logger.info(f"Key loaded from {key_path}")
            return True
        except Exception as e:
            logger.error(f"Failed to load key: {e}")
            return False
    
    def save_key(self, key_path: str) -> bool:
        """Save key to file with restricted permissions."""
        try:
            with open(key_path, 'wb') as f:
                f.write(self.key)
            # Restrict permissions (Unix-like systems)
            try:
                os.chmod(key_path, 0o600)
            except:
                pass  # Windows
            logger.info(f"Key saved to {key_path}")
            return True
        except Exception as e:
            logger.error(f"Failed to save key: {e}")
            return False
    
    def encrypt_data(self, data: bytes) -> bytes:
        """Encrypt data with thread safety."""
        with self._lock:
            return self.cipher.encrypt(data)
    
    def decrypt_data(self, data: bytes) -> bytes:
        """Decrypt data with thread safety."""
        with self._lock:
            return self.cipher.decrypt(data)
    
    def get_key_hash(self) -> str:
        """Get SHA256 hash of key for verification."""
        return hashlib.sha256(self.key).hexdigest() if self.key else ""

