        )
        status_label.pack()
        
        # Log display
        self.log_text = tk.Text(
            self.root,
            bg="#2d2d2d",
            fg="#00FF00",
            font=("Consolas", 9),
            height=10,
            width=70
        )
        self.log_text.pack(pady=10, padx=20)
        
        # Buttons
        btn_frame = tk.Frame(self.root, bg="#1e1e1e")
        btn_frame.pack(pady=10)
        
        self.decrypt_btn = tk.Button(
            btn_frame,
            text="🔓 Start Decryption",
            command=self.start_decryption,
            bg="#00FF00",
            fg="black",
            font=("Consolas", 10, "bold"),
            width=20
        )
        self.decrypt_btn.pack(side="left", padx=10)
        
        tk.Button(
            btn_frame,
            text="📊 Show Statistics",
            command=self.show_stats,
            bg="#0088FF",
            fg="white",
            font=("Consolas", 10, "bold"),
            width=20
        ).pack(side="left", padx=10)
        
    def browse_key(self):
        filename = filedialog.askopenfilename(
            title="Select Key File",
            filetypes=[("Key Files", "*.txt"), ("All Files", "*.*")]
        )
        if filename:
            self.key_path.set(filename)
    
    def browse_directory(self):
        directory = filedialog.askdirectory(title="Select Directory to Decrypt")
        if directory:
            self.dir_path.set(directory)
    
    def log(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.log_text.insert("end", f"[{timestamp}] {message}\n")
        self.log_text.see("end")
        self.root.update()
    
    def update_progress(self, current, total, filename):
        self.progress["value"] = (current / total) * 100
        self.status_var.set(f"Decrypting {current}/{total}: {os.path.basename(filename)}")
        self.root.update()
    
    def start_decryption(self):
        key_file = self.key_path.get()
        directory = self.dir_path.get()
        
        if not os.path.exists(key_file):
            messagebox.showerror("Error", "Key file not found!")
            return
        
        if not os.path.exists(directory):
            messagebox.showerror("Error", "Directory not found!")
            return
        
        # Load and validate key
        self.log("Loading decryption key...")
        if not self.decryptor.load_key(key_file):
            messagebox.showerror("Error", "Failed to load key!")
            return
        
        self.log("Validating key...")
        if not self.decryptor.validate_key():
            if not messagebox.askyesno("Warning", "Key validation failed. Continue anyway?"):
                return
        
        # Start decryption in thread
        self.decrypt_btn.config(state="disabled")
        self.log(f"Starting decryption of {directory}...")
        
        def decrypt_thread():
            result = self.decryptor.decrypt_directory(directory, self.update_progress)
            
            self.root.after(0, lambda: self.decryption_complete(result))
        
        threading.Thread(target=decrypt_thread, daemon=True).start()
    
    def decryption_complete(self, result):
        self.decrypt_btn.config(state="normal")
        self.progress["value"] = 100
        
        if result["status"] == "no_files":
            self.status_var.set("No encrypted files found")
            self.log("No encrypted files found in directory")
            messagebox.showinfo("Complete", "No encrypted files found!")
        else:
            self.status_var.set(f"Decryption complete: {result['decrypted']} recovered, {result['failed']} failed")
            self.log(f"Decryption complete!")
            self.log(f"  Total files: {result['total']}")
            self.log(f"  Decrypted: {result['decrypted']}")
            self.log(f"  Failed: {result['failed']}")
            self.log(f"  Data recovered: {result['size_recovered']} bytes")
            
            messagebox.showinfo(
                "Decryption Complete",
                f"Decrypted: {result['decrypted']} files\n"
                f"Failed: {result['failed']} files\n"
                f"Data recovered: {result['size_recovered'] / 1024:.2f} KB"
            )
    
    def show_stats(self):
        stats = f"""
Decryption Statistics
=====================
Total encrypted files found: {self.decryptor.decrypted_count + self.decryptor.failed_count}
Successfully decrypted: {self.decryptor.decrypted_count}
Failed: {self.decryptor.failed_count}
Total size processed: {self.decryptor.total_size / 1024:.2f} KB
Data recovered: {self.decryptor.decrypted_size / 1024:.2f} KB
Success rate: {(self.decryptor.decrypted_count / max(1, self.decryptor.decrypted_count + self.decryptor.failed_count)) * 100:.1f}%
        """
        
        stats_window = tk.Toplevel(self.root)
        stats_window.title("Statistics")
        stats_window.geometry("400x300")
        stats_window.configure(bg="#1e1e1e")
        
        tk.Label(
            stats_window,
            text=stats,
            bg="#1e1e1e",
            fg="#00FF00",
            font=("Consolas", 10),
            justify="left"
        ).pack(pady=20, padx=20)
    
    def run(self):
        self.root.mainloop()


class CommandLineDecryptor:
    """Command-line interface for the decryptor."""
    
    def __init__(self):
        self.decryptor = RootKilerDecryptor()
    
    def run(self, args):
        import argparse
        
        parser = argparse.ArgumentParser(description="RootKiler Ransomware Decryptor")
        parser.add_argument("-k", "--key", default=DEFAULT_KEY_FILE, help="Path to decryption key")
        parser.add_argument("-d", "--directory", default=".", help="Directory to decrypt")
        parser.add_argument("-v", "--verbose", action="store_true", help="Verbose output")
        parser.add_argument("--delete-encrypted", action="store_true", help="Delete encrypted files after decryption")
        parser.add_argument("--gui", action="store_true", help="Launch GUI mode")
        
        parsed = parser.parse_args(args)
        
        if parsed.gui:
            gui = DecryptorGUI()
            gui.run()
            return
        
        global RESTORE_ORIGINAL
        RESTORE_ORIGINAL = not parsed.delete_encrypted
        
        print("🔓 RootKiler Decryptor 🔓")
        print("=" * 40)
        
        # Load key
        print(f"Loading key from {parsed.key}...")
        if not self.decryptor.load_key(parsed.key):
            print("❌ Failed to load key!")
            return 1
        
        # Validate key
        print("Validating key...")
        if not self.decryptor.validate_key():
            print("⚠️  Key validation failed! Decryption may fail.")
            if input("Continue anyway? (y/n): ").lower() != 'y':
                return 1
        
        # Decrypt
        print(f"\nDecrypting {parsed.directory}...")
        print("-" * 40)
        
        def progress(current, total, filename):
            if parsed.verbose or current % 10 == 0:
                print(f"[{current}/{total}] {os.path.basename(filename)}")
        
        result = self.decryptor.decrypt_directory(parsed.directory, progress)
        
        # Results
        print("\n" + "=" * 40)
        if result["status"] == "no_files":
            print("No encrypted files found.")
        else:
            print(f"✅ Decryption complete!")
            print(f"   Decrypted: {result['decrypted']} files")
            print(f"   Failed: {result['failed']} files")
            print(f"   Recovered: {result['size_recovered'] / 1024:.2f} KB")
        
        return 0


# Emergency single-file decryption
def decrypt_single_file(encrypted_path, key_path):
    """Quick function to decrypt a single file."""
    try:
        with open(key_path, "rb") as f:
            key = f.read()
        cipher = Fernet(key)
        
        with open(encrypted_path, "rb") as f:
            encrypted_data = f.read()
        
        decrypted_data = cipher.decrypt(encrypted_data)
        
        original_path = encrypted_path[:-len(ENCRYPTED_EXT)] if encrypted_path.endswith(ENCRYPTED_EXT) else encrypted_path + ".decrypted"
        
        with open(original_path, "wb") as f:
            f.write(decrypted_data)
        
        return original_path
    except Exception as e:
        print(f"Error: {str(e)}")
        return None


# Bulk decryption with recovery report
def generate_recovery_report(directory, output_file="recovery_report.json"):
    """Generate a JSON report of recovery status."""
    decryptor = RootKilerDecryptor()
    encrypted_files = decryptor.scan_encrypted_files(directory)
    
    report = {
        "timestamp": str(datetime.now()),
        "directory": directory,
        "encrypted_files_found": len(encrypted_files),
        "files": []
    }
    
    for file_path in encrypted_files:
        file_info = {
            "path": file_path,
            "size": os.path.getsize(file_path),
            "status": "pending"
        }
        report["files"].append(file_info)
    
    with open(output_file, "w") as f:
        json.dump(report, f, indent=2)
    
    return report


