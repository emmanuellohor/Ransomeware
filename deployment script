#!/usr/bin/env python3
"""
RootKiler Ransomware Decryptor
Recovers files encrypted by the RootKiler simulator
For authorized security research and incident response only
"""

import os
import sys
import time
import logging
from pathlib import Path
from cryptography.fernet import Fernet
import tkinter as tk
from tkinter import filedialog, messagebox, ttk
import threading
import json
from datetime import datetime

# Configuration
ENCRYPTED_EXT = ".encrypted"
DEFAULT_KEY_FILE = "decryption_key.txt"
LOG_FILE = "decryption_log.txt"
RESTORE_ORIGINAL = True  # Keep encrypted copy until decryption verified

# Setup logging
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

class RootKilerDecryptor:
    def __init__(self):
        self.cipher = None
        self.key = None
        self.decrypted_count = 0
        self.failed_count = 0
        self.skipped_count = 0
        self.total_size = 0
        self.decrypted_size = 0
        
    def load_key(self, key_path):
        """Load the Fernet encryption key."""
        try:
            with open(key_path, "rb") as f:
                self.key = f.read()
            self.cipher = Fernet(self.key)
            logging.info(f"Key loaded successfully from {key_path}")
            return True
        except FileNotFoundError:
            logging.error(f"Key file not found: {key_path}")
            return False
        except Exception as e:
            logging.error(f"Error loading key: {str(e)}")
            return False
    
    def validate_key(self, test_file=None):
        """Validate the key by testing decryption on a sample file."""
        if not self.cipher:
            return False
            
        # If no test file provided, find first encrypted file
        if not test_file:
            for root, _, files in os.walk("."):
                for file in files:
                    if file.endswith(ENCRYPTED_EXT):
                        test_file = os.path.join(root, file)
                        break
                if test_file:
                    break
        
        if not test_file or not os.path.exists(test_file):
            logging.warning("No encrypted files found for key validation")
            return True  # No files to test, assume key is valid
            
        try:
            with open(test_file, "rb") as f:
                encrypted_data = f.read()
            decrypted_data = self.cipher.decrypt(encrypted_data)
            logging.info(f"Key validated successfully using {test_file}")
            return True
        except Exception as e:
            logging.error(f"Key validation failed: {str(e)}")
            return False
    
    def decrypt_file(self, encrypted_path):
        """Decrypt a single file."""
        try:
            # Read encrypted data
            with open(encrypted_path, "rb") as f:
                encrypted_data = f.read()
            
            # Decrypt
            decrypted_data = self.cipher.decrypt(encrypted_data)
            
            # Determine original path
            if encrypted_path.endswith(ENCRYPTED_EXT):
                original_path = encrypted_path[:-len(ENCRYPTED_EXT)]
            else:
                original_path = encrypted_path + ".decrypted"
            
            # Write decrypted data
            with open(original_path, "wb") as f:
                f.write(decrypted_data)
            
            # Verify decryption
            with open(original_path, "rb") as f:
                verify_data = f.read()
            
            if verify_data == decrypted_data:
                if not RESTORE_ORIGINAL:
                    os.remove(encrypted_path)  # Remove encrypted version
                self.decrypted_count += 1
                self.decrypted_size += len(decrypted_data)
                logging.info(f"Decrypted: {encrypted_path} -> {original_path}")
                return True
            else:
                logging.error(f"Verification failed for {encrypted_path}")
                self.failed_count += 1
                return False
                
        except Exception as e:
            logging.error(f"Failed to decrypt {encrypted_path}: {str(e)}")
            self.failed_count += 1
            return False
    
    def scan_encrypted_files(self, directory):
        """Scan directory for encrypted files."""
        encrypted_files = []
        for root, _, files in os.walk(directory):
            for file in files:
                if file.endswith(ENCRYPTED_EXT):
                    full_path = os.path.join(root, file)
                    encrypted_files.append(full_path)
                    self.total_size += os.path.getsize(full_path)
        return encrypted_files
    
    def decrypt_directory(self, directory, progress_callback=None):
        """Decrypt all encrypted files in directory."""
        encrypted_files = self.scan_encrypted_files(directory)
        total_files = len(encrypted_files)
        
        if total_files == 0:
            logging.info("No encrypted files found")
            return {"status": "no_files", "decrypted": 0, "failed": 0}
        
        logging.info(f"Found {total_files} encrypted files ({self.total_size} bytes)")
        
        for i, file_path in enumerate(encrypted_files, 1):
            if progress_callback:
                progress_callback(i, total_files, file_path)
            
            self.decrypt_file(file_path)
            
            # Small delay to prevent system overload
            time.sleep(0.01)
        
        return {
            "status": "completed",
            "total": total_files,
            "decrypted": self.decrypted_count,
            "failed": self.failed_count,
            "skipped": self.skipped_count,
            "size_recovered": self.decrypted_size
        }


